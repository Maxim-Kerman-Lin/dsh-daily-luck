{
  "name": "dsh-daily-luck",
  "version": "1.0.0",
  "type": "module",
  "description": "今日好运来临：写入生日，用真实星历生成本地基础运势，抽一张大阿尔卡纳，得到五维评分与针对问题的具体回答。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tarot",
    "daily-luck",
    "astrology",
    "widget"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxim-Kerman-Lin/dsh-daily-luck.git"
  },
  "homepage": "https://github.com/Maxim-Kerman-Lin/dsh-daily-luck#readme",
  "bugs": {
    "url": "https://github.com/Maxim-Kerman-Lin/dsh-daily-luck/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
